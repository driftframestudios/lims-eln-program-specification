{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframestudios.org/lims-eln-program-specification/v0.3.1/program-release-observation.v1.schema.json",
  "title": "Program release observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "release_observation_id",
    "promotion_receipt_id",
    "repository",
    "target_release",
    "observation_state",
    "evidence_mode",
    "assurance_stage",
    "candidate_receipt",
    "candidate_source",
    "release_subject",
    "signature_observation",
    "workflow_observation",
    "review_observation",
    "accountable_role",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/program-release-observation.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "release_observation_id": {
      "const": "OBS-PROGRAM-RELEASE-003"
    },
    "promotion_receipt_id": {
      "const": "RCP-PROGRAM-PROMOTION-003"
    },
    "repository": {
      "const": "driftframestudios/lims-eln-program-specification"
    },
    "target_release": {
      "const": "spec-v0.3.1"
    },
    "observation_state": {
      "enum": [
        "pending_post_tag",
        "release_observed"
      ]
    },
    "evidence_mode": {
      "enum": [
        "planned",
        "observed"
      ]
    },
    "assurance_stage": {
      "enum": [
        "specified",
        "verified"
      ]
    },
    "candidate_receipt": {
      "$ref": "#/$defs/candidateReceipt"
    },
    "candidate_source": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidateSource"
        }
      ]
    },
    "release_subject": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/releaseSubject"
        }
      ]
    },
    "signature_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/signatureObservation"
        }
      ]
    },
    "workflow_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/workflowObservation"
        }
      ]
    },
    "review_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/releaseReviewObservation"
        }
      ]
    },
    "accountable_role": {
      "const": "Program release stewardship"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_state": {
            "const": "pending_post_tag"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_mode": {
            "const": "planned"
          },
          "assurance_stage": {
            "const": "specified"
          },
          "candidate_source": {
            "type": "null"
          },
          "release_subject": {
            "type": "null"
          },
          "signature_observation": {
            "type": "null"
          },
          "workflow_observation": {
            "type": "null"
          },
          "review_observation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_state": {
            "const": "release_observed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_mode": {
            "const": "observed"
          },
          "assurance_stage": {
            "const": "verified"
          },
          "candidate_source": {
            "$ref": "#/$defs/candidateSource"
          },
          "release_subject": {
            "$ref": "#/$defs/releaseSubject"
          },
          "signature_observation": {
            "$ref": "#/$defs/signatureObservation"
          },
          "workflow_observation": {
            "$ref": "#/$defs/workflowObservation"
          },
          "review_observation": {
            "$ref": "#/$defs/releaseReviewObservation"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha1Oid": {
      "type": "string",
      "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "candidateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "const": "receipts/promotion-receipt.json"
        },
        "digest": {
          "const": "sha256:3d20ee1db9dc966929773ca97e7b365dc4bea2aaaa49b4d8f26209e8b93c1f98"
        }
      }
    },
    "candidateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_oid",
        "tree_oid"
      ],
      "properties": {
        "commit_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/sha1Oid"
        }
      }
    },
    "releaseSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_object_format",
        "tag",
        "tag_object_oid",
        "commit_oid",
        "tree_oid",
        "archive_format",
        "archive_digest",
        "promoted_at"
      ],
      "properties": {
        "git_object_format": {
          "const": "sha1"
        },
        "tag": {
          "const": "spec-v0.3.1"
        },
        "tag_object_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "commit_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "archive_format": {
          "const": "git-archive-tar"
        },
        "archive_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "promoted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signatureObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification",
        "trusted_signers_path",
        "trusted_signers_digest"
      ],
      "properties": {
        "verification": {
          "const": "valid"
        },
        "trusted_signers_path": {
          "const": "release/trusted-release-signers"
        },
        "trusted_signers_digest": {
          "const": "sha256:fa40606c492a312e284da51c48e9077f66d2d47e7e37f7190732ef62151668ad"
        }
      }
    },
    "workflowObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "workflow_name",
        "check_context",
        "run_id",
        "job_id",
        "conclusion"
      ],
      "properties": {
        "workflow_path": {
          "const": ".github/workflows/validate.yml"
        },
        "workflow_name": {
          "const": "Validate program specification"
        },
        "check_context": {
          "const": "program-validation"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "conclusion": {
          "const": "success"
        }
      }
    },
    "releaseReviewObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request",
        "merge_admission",
        "independent_review",
        "github_review_record"
      ],
      "properties": {
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "merge_admission": {
          "const": "configured_ordinary_bypass"
        },
        "independent_review": {
          "const": "deputized_independent_review_completed"
        },
        "github_review_record": {
          "const": "no_formal_review_submitted"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "owner"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "display_name",
            "role"
          ],
          "properties": {
            "actor_id": {
              "const": "OWNER-PROGRAM-RELEASE-OBSERVATION-003"
            },
            "display_name": {
              "const": "Program release stewardship role"
            },
            "role": {
              "const": "Release observation owner"
            }
          }
        }
      }
    }
  }
}

  "automation_controls": {
    "contract_version": "1.0.0",
    "pull_request": {
      "path": ".github/workflows/pull-request.yml",
      "name": "Program pull request",
      "targets": ["develop", "main"],
      "permissions": {"contents": "read"},
      "concurrency": {
        "group": "program-pr-${{ github.event.pull_request.number }}",
        "cancel-in-progress": true
      },
      "job": {
        "id": "program-pr-validation",
        "name": "program-pr-validation",
        "runner": "ubuntu-24.04",
        "timeout_minutes": 10,
        "python_version": "3.12",
        "step_names": [
          "Check out the proposed source",
          "Select Python",
          "Install the contract model boundary",
          "Validate repository-owned contracts"
        ],
        "checkout_action": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "setup_python_action": "actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97",
        "install_command": "python -m pip install --disable-pip-version-check .",
        "validation_commands": [
          "python scripts/validate_program.py",
          "python scripts/check_language.py",
          "python scripts/scan_secret_shapes.py",
          "PYTHONPATH=src python scripts/generate_contract_schemas.py --check",
          "python -m unittest discover -s tests -v"
        ]
      }
    },
    "dependabot": {
      "path": ".github/dependabot.yml",
      "version": 2,
      "updates": [
        {
          "package-ecosystem": "github-actions",
          "directory": "/",
          "target-branch": "develop",
          "schedule": {"interval": "monthly"},
          "open-pull-requests-limit": 2,
          "groups": {
            "github-actions-minor-patch": {
              "patterns": ["*"],
              "update-types": ["minor", "patch"]
            }
          }
        }
      ]
    }
  },

{
  "$defs": {
    "ExpectedStudyPair": {
      "additionalProperties": false,
      "description": "An authored oracle; observed values remain independently admissible.",
      "properties": {
        "administrative_changed": {
          "title": "Administrative Changed",
          "type": "boolean"
        },
        "pair_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Pair Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scientific_changed": {
          "title": "Scientific Changed",
          "type": "boolean"
        }
      },
      "required": [
        "pair_id",
        "scientific_changed",
        "administrative_changed",
        "rationale"
      ],
      "title": "ExpectedStudyPair",
      "type": "object"
    },
    "StudyBinding": {
      "additionalProperties": false,
      "description": "Identity/version and digest of the source-owned artifact.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "StudyBinding",
      "type": "object"
    },
    "StudyExecution": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Adapter Version",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "model_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Model Id",
          "type": "string"
        },
        "prompt_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Prompt Digest",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "model_id",
        "adapter_version",
        "prompt_digest",
        "configuration_digest"
      ],
      "title": "StudyExecution",
      "type": "object"
    },
    "StudyFactor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "standing": {
          "enum": [
            "specified",
            "unknown",
            "omitted",
            "unmeasured",
            "withheld"
          ],
          "title": "Standing",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "standing"
      ],
      "title": "StudyFactor",
      "type": "object"
    },
    "StudyOutput": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "text": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "digest",
        "completeness"
      ],
      "title": "StudyOutput",
      "type": "object"
    },
    "StudyRunObservation": {
      "additionalProperties": false,
      "properties": {
        "administrative_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempt": {
          "maximum": 8,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyExecution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_order": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Order"
        },
        "finished_at": {
          "anyOf": [
            {
              "maxLength": 27,
              "minLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "input_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Observation Id",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Run Id",
          "type": "string"
        },
        "scientific_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "specification_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Specification Digest",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "maxLength": 27,
              "minLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "abstained",
            "timeout",
            "cancelled",
            "invalid_response",
            "failed",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "run_id",
        "attempt",
        "specification_digest",
        "input_digest",
        "status"
      ],
      "title": "StudyRunObservation",
      "type": "object"
    },
    "StudyRunPlan": {
      "additionalProperties": false,
      "properties": {
        "administrative_input": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Administrative Input",
          "type": "string"
        },
        "arm": {
          "enum": [
            "a",
            "b"
          ],
          "title": "Arm",
          "type": "string"
        },
        "episode_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Episode Id",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/StudyFactor"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Factors",
          "type": "array"
        },
        "pair_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Pair Id",
          "type": "string"
        },
        "repeat_index": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Scenario Id",
          "type": "string"
        },
        "scientific_evidence": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Scientific Evidence",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "pair_id",
        "arm",
        "scenario_id",
        "subject_id",
        "episode_id",
        "repeat_index",
        "factors",
        "scientific_evidence",
        "administrative_input"
      ],
      "title": "StudyRunPlan",
      "type": "object"
    },
    "StudySpecification": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/StudyBinding"
        },
        "controlled_factors": {
          "default": [],
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Controlled Factors",
          "type": "array"
        },
        "controlled_fields": {
          "default": [
            "scientific_evidence",
            "subject_id",
            "episode_id"
          ],
          "items": {
            "enum": [
              "scientific_evidence",
              "subject_id",
              "episode_id"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Controlled Fields",
          "type": "array"
        },
        "expected_execution": {
          "$ref": "#/$defs/StudyExecution"
        },
        "expected_invariant_outputs": {
          "default": [
            "scientific"
          ],
          "items": {
            "enum": [
              "scientific",
              "administrative"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Expected Invariant Outputs",
          "type": "array"
        },
        "factor_names": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Factor Names",
          "type": "array"
        },
        "max_attempts_per_run": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Attempts Per Run",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/StudyBinding"
        },
        "primary_endpoint": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Primary Endpoint",
          "type": "string"
        },
        "question": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requested_return": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Requested Return",
          "type": "string"
        },
        "scoring": {
          "$ref": "#/$defs/StudyBinding"
        },
        "source": {
          "$ref": "#/$defs/SyntheticStudySource"
        },
        "stopping_rule": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Stopping Rule",
          "type": "string"
        },
        "study_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Study Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "version",
        "question",
        "requested_return",
        "primary_endpoint",
        "scoring",
        "source",
        "catalog",
        "policy",
        "expected_execution",
        "factor_names",
        "stopping_rule"
      ],
      "title": "StudySpecification",
      "type": "object"
    },
    "SyntheticStudySource": {
      "additionalProperties": false,
      "description": "A provenance assertion; artifact review establishes its truth.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/StudyBinding"
        },
        "construction": {
          "enum": [
            "authored_fixture",
            "synthetic_generator"
          ],
          "title": "Construction",
          "type": "string"
        },
        "data_class": {
          "const": "synthetic",
          "title": "Data Class",
          "type": "string"
        },
        "purpose": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "review_ref": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
          "title": "Review Ref",
          "type": "string"
        }
      },
      "required": [
        "data_class",
        "construction",
        "artifact",
        "review_ref",
        "purpose"
      ],
      "title": "SyntheticStudySource",
      "type": "object"
    }
  },
  "$id": "urn:driftframe:lims-eln:administrative-study:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:driftframe:lims-eln:administrative-study:1.0.0",
      "title": "$Schema",
      "type": "string"
    },
    "expected_pairs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExpectedStudyPair"
      },
      "maxItems": 256,
      "title": "Expected Pairs",
      "type": "array"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StudyRunObservation"
      },
      "maxItems": 4096,
      "title": "Observations",
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/StudyRunPlan"
      },
      "maxItems": 512,
      "minItems": 2,
      "title": "Runs",
      "type": "array"
    },
    "specification": {
      "$ref": "#/$defs/StudySpecification"
    }
  },
  "required": [
    "$schema",
    "specification",
    "runs"
  ],
  "title": "AdministrativeStudy",
  "type": "object",
  "x-semantic-invariants": [
    "run and observation identities are unique; every pair has arms a and b",
    "observations bind their declared run, study specification and input digests",
    "factors resolve exactly to the specification and retain explicit absence states",
    "completed runs contain both complete outputs; other statuses preserve their own fields",
    "expected output invariants remain separate from admission of actual outcomes"
  ]
}

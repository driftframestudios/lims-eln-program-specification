      "purpose": "Supply the jurisdiction and effective interval used by the receiving context."
    },
    {
      "field_name": "classification_vocabulary",
      "source": "governed_vocabulary",
      "purpose": "Resolve normalized labels into identified terms while preserving the raw input."
    },
    {
      "field_name": "provenance_and_review",

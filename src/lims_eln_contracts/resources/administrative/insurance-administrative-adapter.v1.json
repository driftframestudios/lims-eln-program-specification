  "stages": [
    {
      "stage_id": "ADAPTER-STAGE-EXTRACT",
      "sequence": 1,
      "kind": "extract",
      "input_resource": "ADMINISTRATIVE-ADAPTER-INPUT-V1",
      "output_resource": "ADMINISTRATIVE-RAW-ENVELOPE-V1",
      "operation": "Read repository-owned representative records without changing their raw values.",
      "implementation_pattern": "declarative_contract",
      "idempotent": true
    },
    {
      "stage_id": "ADAPTER-STAGE-VALIDATE",
      "sequence": 2,
      "kind": "validate",
      "input_resource": "ADMINISTRATIVE-RAW-ENVELOPE-V1",
      "output_resource": "ADMINISTRATIVE-VALIDATED-ENVELOPE-V1",
      "operation": "Validate required record identity, version, raw label, and enrollment-state shapes.",
      "implementation_pattern": "declarative_contract",
      "idempotent": true
    },
    {
      "stage_id": "ADAPTER-STAGE-NORMALIZE",
      "sequence": 3,
      "kind": "normalize",
      "input_resource": "ADMINISTRATIVE-VALIDATED-ENVELOPE-V1",
      "output_resource": "ADMINISTRATIVE-NORMALIZED-ENVELOPE-V1",
      "operation": "Preserve raw labels beside normalized values and explicit missingness.",
      "implementation_pattern": "idempotent_script",
      "idempotent": true
    },
    {
      "stage_id": "ADAPTER-STAGE-CLASSIFY",
      "sequence": 4,
      "kind": "classify",
      "input_resource": "ADMINISTRATIVE-NORMALIZED-ENVELOPE-V1",
      "output_resource": "ADMINISTRATIVE-CLASSIFICATION-V1",
      "operation": "Produce multi-label, abstained, or unknown classifications with provenance.",
      "implementation_pattern": "idempotent_script",
      "idempotent": true
    },
    {
      "stage_id": "ADAPTER-STAGE-CONTRACT-MAP",
      "sequence": 5,
      "kind": "map_contract",
      "input_resource": "ADMINISTRATIVE-CLASSIFICATION-V1",
      "output_resource": "ADMINISTRATIVE-CONTRACT-MAP-V1",
      "operation": "Map raw-preserving classification and enrollment state into Program contract identities without producing a policy or accountable decision.",
      "implementation_pattern": "idempotent_script",
      "idempotent": true
    },
    {
      "stage_id": "ADAPTER-STAGE-EMIT",
      "sequence": 6,
      "kind": "emit",
      "input_resource": "ADMINISTRATIVE-CONTRACT-MAP-V1",
      "output_resource": "ADMINISTRATIVE-CONTRACT-PROJECTION-V1",
      "operation": "Emit canonical contract projections keyed by record identity and input version.",
      "implementation_pattern": "idempotent_script",
      "idempotent": true
    }
  ],
  "idempotency": {
    "key_fields": [
      "record_id",
      "input_version"
    ],
    "duplicate_input_effect": "same_output_no_additional_effect",
    "replay_scope": "One adapter version and one canonical representative-record payload.",
    "checkpoint_strategy": "Commit a complete canonical projection only after every stage succeeds.",
    "retry_behavior": "Retry the same replay key from the first stage and replace only with byte-identical canonical output."
  },
  "output_bundle_id": "ADMINISTRATIVE-CONTRACT-PROJECTION-V1",
  "output_object_names": [
    "AdministrativeContext",
    "InsuranceClassification",
    "CoverageEnrollment"
  ],
  "required_enrichments": [
